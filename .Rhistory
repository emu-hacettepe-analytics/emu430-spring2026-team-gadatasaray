# Data Preparation and Loading
library(readr)
library(dplyr)
library(ggplot2)
library(tidyr)
# Loading all 8 seasons WITH Season Labels
s18 <- read_csv("turkey-super-lig-teams-2018-to-2019-stats.csv", show_col_types = FALSE) %>% mutate(Season = "18/19")
s19 <- read_csv("turkey-super-lig-teams-2019-to-2020-stats.csv", show_col_types = FALSE) %>% mutate(Season = "19/20")
s20 <- read_csv("turkey-super-lig-teams-2020-to-2021-stats.csv", show_col_types = FALSE) %>% mutate(Season = "20/21")
s21 <- read_csv("turkey-super-lig-teams-2021-to-2022-stats.csv", show_col_types = FALSE) %>% mutate(Season = "21/22")
s22 <- read_csv("turkey-super-lig-teams-2022-to-2023-stats.csv", show_col_types = FALSE) %>% mutate(Season = "22/23")
s23 <- read_csv("turkey-super-lig-teams-2023-to-2024-stats.csv", show_col_types = FALSE) %>% mutate(Season = "23/24")
s24 <- read_csv("turkey-super-lig-teams-2024-to-2025-stats.csv", show_col_types = FALSE) %>% mutate(Season = "24/25")
s25 <- read_csv("turkey-super-lig-teams-2025-to-2026-stats.csv", show_col_types = FALSE) %>% mutate(Season = "25/26")
all_data <- bind_rows(s18, s19, s20, s21, s22, s23, s24, s25)
# Creating xGD and Championship Status
analysis_data <- all_data %>%
mutate(
xGD = xg_for_avg_overall - xg_against_avg_overall,
is_champion = ifelse(league_position == 1, "Champion", "Other Teams")
)
# 21/22 Sezonu İlk 4 Takım Veri Kontrolü
kontrol_2122 <- analysis_data %>%
filter(Season == "21/22", league_position <= 4) %>%
select(Takim = common_name, Sira = league_position, xG = xg_for_avg_overall, xGA = xg_against_avg_overall, xGD) %>%
arrange(Sira)
print(kontrol_2122)
